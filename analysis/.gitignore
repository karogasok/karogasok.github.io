.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage

# Derived artefacts: rebuildable from the corpus by re-running the scripts.
# The embedding cache in particular is large and machine-specific.
out/*

# ...except the topic names, which are hand-reviewed. Derived data is
# rebuildable; a human judgement about what a cluster of writing is *called*
# is not, and losing it would mean doing the review again.
!out/topic_names.json
