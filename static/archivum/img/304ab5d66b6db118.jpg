f;border-radius:100%;content:"";height:3.5555555556px;inset-inline-start:50%;margin-inline-start:-5.3333333333px;margin-top:-5.3333333333px;position:absolute;top:50%;transform-origin:5.3333333333px 5.3333333333px;width:3.5555555556px}.wp-block-jetpack-donations .donations__tab.is-annual :is(.donations__monthly-item,.donations__one-time-item),.wp-block-jetpack-donations .donations__tab.is-monthly :is(.donations__annual-item,.donations__one-time-item),.wp-block-jetpack-donations .donations__tab.is-one-time :is(.donations__annual-item,.donations__monthly-item){display:none}.wp-block-jetpack-donations .donations__amount{cursor:pointer}.wp-block-jetpack-donations .donations__amount.is-selected{box-shadow:0 0 0 1px #fff,0 0 0 3px #3858e9;outline:2px solid #0000;outline-offset:-2px}.wp-block-jetpack-donations .donations__custom-amount{cursor:text}.wp-block-jetpack-donations .donations__custom-amount .donations__amount-value{display:inline-block;text-align:start;white-space:pre-wrap}.wp-block-jetpack-donations .donations__custom-amount .donations__amount-value:empty:after{color:#ccc;content:attr(data-empty-text)}.wp-block-jetpack-donations .donations__custom-amount .donations__amount-value:focus{outline:none}.wp-block-jetpack-donations .donations__range-error{color:#cc1818;display:none;font-size:.875em;margin-block-end:8px}.wp-block-jetpack-donations .donations__range-error.is-visible{display:block}.wp-block-jetpack-donations .donations__donate-button.is-disabled{opacity:.2;pointer-events:none}.wp-block-jetpack-donations.is-display-modal.is-sticky{bottom:24px;inset-inline-end:24px;position:fixed;z-index:9999}.wp-block-jetpack-donations .donations__trigger-button{align-items:center;display:inline-flex;gap:8px}.wp-block-jetpack-donations .donations__trigger-icon{fill:currentColor;flex-shrink:0}.wp-block-jetpack-donations .donations__modal-overlay{align-items:center;backdrop-filter:blur(5px);background:#00000073;display:flex;inset:0;justify-content:center;position:fixed;z-inde